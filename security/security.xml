<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_odoo_chatbot" model="ir.module.category">
        <field name="name">AI Chatbot</field>
        <field name="sequence">60</field>
    </record>

    <record id="res_groups_privilege_odoo_chatbot" model="res.groups.privilege">
        <field name="name">AI Chatbot</field>
        <field name="category_id" ref="module_category_odoo_chatbot"/>
    </record>

    <record id="group_chatbot_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_odoo_chatbot"/>
    </record>

    <record id="group_chatbot_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_odoo_chatbot"/>
        <field name="implied_ids" eval="[Command.link(ref('group_chatbot_user'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
    </record>

    <!-- Every internal user can use the chatbot -->
    <!-- If we remove this record, access must be assigned manually -->
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_chatbot_user'))]"/>
    </record>
</odoo>