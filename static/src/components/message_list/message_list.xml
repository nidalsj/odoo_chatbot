<?xml version="1.0" encoding="UTF-8" ?>
<template>
    <t t-name="odoo_chatbot.MessageList">
        <div class="o_chatbot_messages" t-ref="this.listRef">
            <div t-if="!this.props.messages.length and !this.props.sending" class="o_chatbot_empty">
                Ask anything about your Odoo data...
            </div>
            <t t-foreach="this.props.messages" t-as="msg" t-key="msg.id">
                <div t-if="msg.role === 'user'" class="o_chatbot_row o_chatbot_row--user">
                    <div class="o_chatbot_bubble" t-out="msg.text"/>
                </div>
                <div t-else="" class="o_chatbot_row o_chatbot_row--bot">
                    <div class="o_chatbot_bot_label">Chatbot</div>
                    <div t-if="msg.status === 'error'" class="o_chatbot_error" t-out="msg.text"/>
                    <TableResult t-elif="msg.result and msg.result.type === 'table'" result="msg.result"/>
                    <div t-else="" class="o_chatbot_text" t-out="msg.text"/>
                </div>
            </t>
            <div t-if="this.props.sending" class="o_chatbot_row o_chatbot_row--bot">
                <div class="o_chatbot_bot_label">Chatbot</div>
                <div class="o_chatbot_typing"><span/><span/><span/></div>
            </div>
        </div>
    </t>
</template>