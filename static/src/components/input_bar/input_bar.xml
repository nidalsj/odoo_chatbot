<?xml version="1.0" encoding="UTF-8" ?>
<template>
    <t t-name="odoo_chatbot.InputBar">
        <div class="o_chatbot_inputbar">
            <div class="o_chatbot_delete_wrap">
                <button type="button" class="o_chatbot_icon_btn" title="Delete this chat"
                        t-att-disabled="!this.props.canDelete || this.props.sending"
                        t-on-click="() => this.askDelete()">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="3 6 5 6 21 6"/>
                        <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                        <path d="M10 11v6M14 11v6"/>
                        <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/>
                    </svg>
                </button>
                <div t-if="this.state.confirming" class="o_chatbot_confirm" role="alertdialog">
                    <div class="mb-2">Delete this chat?</div>
                    <div class="d-flex gap-2 justify-content-end">
                        <button type="button" class="btn btn-sm btn-light" t-on-click="() => this.cancelDelete()">Cancel</button>
                        <button type="button" class="btn btn-sm btn-danger" t-on-click="() => this.confirmDelete()">Delete</button>
                    </div>
                </div>
            </div>
            <textarea class="o_chatbot_input" rows="1" maxlength="1000"
                      placeholder="Ask Anything in Odoo.."
                      t-ref="this.inputRef" t-model="this.draft"
                      t-on-keydown="(ev) => this.onKeydown(ev)"
                      t-on-input="() => this.onInput()"/>
            <button type="button" class="btn btn-primary o_chatbot_send"
                    t-att-disabled="!this.canSend" t-on-click="() => this.submit()">Send</button>
        </div>
    </t>
</template>